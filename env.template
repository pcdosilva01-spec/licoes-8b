# Variáveis para produção na Vercel e desenvolvimento local.
# Nunca faça commit do arquivo .env.

# MySQL/TiDB/PlanetScale compatível com o schema Drizzle.
# Para TiDB Cloud, o projeto configura SSL automaticamente como objeto TLS 1.2.
# Nao acrescente ssl=true; o mysql2 exige um objeto SSL, que a aplicacao monta.
DATABASE_URL=

# Assina as sessões locais por cookie; use um valor aleatório longo.
JWT_SECRET=

# Storage privado de PDFs (AWS S3 ou serviço S3-compatible).
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional para S3-compatible, como Cloudflare R2/MinIO.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Segredo usado pelo Vercel Cron para chamar a limpeza diária.
CRON_SECRET=
